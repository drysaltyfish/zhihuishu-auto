  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.3.3",
    "vite": "^5.4.10",
    "vue": "^3.5.12",
    "vue-router": "^4.6.4"
  }
}
