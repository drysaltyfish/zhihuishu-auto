  "license": "UNLICENSED",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "web:build": "vite build --config web/vite.config.js",
    "test": "node --test",
    "start": "node server/index.mjs",
    "start:mock": "node server/index.mjs --mock",
    "browsers:install": "node scripts/install-browsers.mjs",
    "desktop:dev": "electron .",
    "desktop:dir": "npm run web:build && electron-builder --dir",
