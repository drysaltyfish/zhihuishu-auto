@echo off
chcp 65001 >nul
cd /d "%~dp0\.."
title 智慧树 spike 探针
echo ============================================================
echo  智慧树 spike 探针   （约 12-15 分钟）
echo ============================================================
echo.
echo  1. 稍等会弹出一个 Chrome 窗口（这是全新的独立配置，不是你日常的 Chrome）
echo  2. 在窗口里点【登录】 -^> 用微信扫码登录
echo  3. 登录后，自己点进那门心理课的播放页（能看到视频的页面）
echo  4. 然后就别管了：脚本会自动把窗口移到屏幕外，采样 10 分钟
echo  5. 期间请正常用电脑，但不要关闭那个 Chrome 窗口
echo.
echo  注意：脚本会自动尝试播放。若视频一直不动，日志里会写 NOT_PLAYING。
echo.
echo ------------------------------------------------------------
node "spike\src\probe.mjs" --minutes 10 --rate 1.25
echo.
echo ------------------------------------------------------------
echo  跑完了。日志在 spike\logs\ 下。把 summary 那段发给我即可。
echo.
pause
